<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Paleta del logo -->
    <Color x:Key="LogoOutline">#2B2550</Color>
    <Color x:Key="LogoShadow">#3A3157</Color>
    <Color x:Key="LogoSlate">#343A4F</Color>
    <Color x:Key="LogoSlateDark">#262A38</Color>
    <Color x:Key="LogoSlateLight">#4A5270</Color>
    <Color x:Key="LogoSky">#66C4FF</Color>
    <Color x:Key="LogoSkyDeep">#4FA5DE</Color>
    <Color x:Key="LogoLavender">#A8B4FF</Color>
    <Color x:Key="LogoCream">#FDFDE6</Color>
    <Color x:Key="LogoCreamDark">#C9C9A0</Color>
    <Color x:Key="LogoYellow">#FDFBC8</Color>
    <Color x:Key="LogoMint">#A6F5A8</Color>
    <Color x:Key="LogoPink">#FF9CCF</Color>
    <Color x:Key="LogoCyan">#9EE4FF</Color>

    <!-- Colores de la app -->
    <Color x:Key="Primary">#343A4F</Color>
    <Color x:Key="PrimaryDark">#66C4FF</Color>
    <Color x:Key="PrimaryDarkText">#262A38</Color>
    <Color x:Key="Secondary">#A8B4FF</Color>
    <Color x:Key="SecondaryDarkText">#A8B4FF</Color>
    <Color x:Key="Tertiary">#2B2550</Color>

    <!-- Estados (las tres luces de la cámara) -->
    <Color x:Key="Success">#A6F5A8</Color>
    <Color x:Key="Danger">#FF9CCF</Color>
    <Color x:Key="Info">#9EE4FF</Color>
    <!-- Texto sobre los colores pastel (contraste) -->
    <Color x:Key="OnStatus">#262A38</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#FF9CCF</Color>
    <Color x:Key="MidnightBlue">#2B2550</Color>
    <Color x:Key="OffBlack">#262A38</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="OnStatusBrush" Color="{StaticResource OnStatus}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
