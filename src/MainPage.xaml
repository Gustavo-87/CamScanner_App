<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CamScanner.Models"
             x:Class="CamScanner.MainPage"
             x:Name="Root"
             Title="CamScanner"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <ContentPage.Resources>
        <!-- Anula el estilo global de BoxView (Gray200), que dejaba un bloque gris detrás de su Color -->
        <Style TargetType="BoxView">
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>

        <!-- Círculo del icono en cada opción del menú -->
        <Style x:Key="MenuIcon" TargetType="Border">
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        </Style>
        <Style x:Key="MenuEmoji" TargetType="Label">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="MenuText" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        </Style>
        <!-- Hoja inferior -->
        <Style x:Key="Sheet" TargetType="Border">
            <Setter Property="VerticalOptions" Value="End" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24,24,0,0" />
            <Setter Property="Padding" Value="24,12,24,24" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" />
        </Style>
    </ContentPage.Resources>

    <Grid>

        <!-- Contenido principal con padding (el menú inferior queda fuera para cubrir toda la pantalla) -->
        <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">

            <!-- ============ LISTA DE LOTES ============ -->
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Label Text="Mis lotes" FontSize="18" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <CollectionView x:Name="LotesView" ItemsSource="{Binding Lotes}" HeightRequest="82"
                                SelectionMode="Single" SelectionChanged="OnLoteSeleccionado">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Text="Aún no hay lotes" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Lote">
                            <Border WidthRequest="180" Padding="12" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                    <Label Text="{Binding FechaCreacion, StringFormat='{0:dd MMM yyyy}'}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ============ LISTA DE DOCUMENTOS ============ -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding Documentos}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="40">
                        <Label Text="📄" FontSize="64" HorizontalOptions="Center" />
                        <Label Text="Aún no hay documentos"
                           FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label Text="Toca + para tomar una foto o importar una imagen"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Documento">
                        <Border Margin="0,6" Padding="10" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDocumentoTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="56,*,44" ColumnSpacing="12">
                                <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                    <Image Source="{Binding RutaImagen}" Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                    <Label Text="{Binding FechaCreacion, StringFormat='{0:dd MMM yyyy, HH:mm}'}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                </VerticalStackLayout>

                                <!-- Botón ⋮ : abre el menú contextual del documento -->
                                <Button Grid.Column="2" Text="⋮" FontSize="24" Padding="0"
                                    WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                                    Clicked="OnMenuDocumentoClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Espacio para que el botón + no tape el último elemento -->
                <CollectionView.Footer>
                    <BoxView HeightRequest="96" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>

            <!-- ============ BOTÓN FLOTANTE (+) ============ -->
            <Button x:Name="Fab" Grid.Row="1" Text="+" FontSize="32" Padding="0,0,0,4"
                WidthRequest="60" HeightRequest="60" CornerRadius="30"
                HorizontalOptions="End" VerticalOptions="End"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                SemanticProperties.Description="Agregar documento"
                Clicked="OnFabClicked">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,4" />
                </Button.Shadow>
            </Button>

        </Grid>

        <!-- ============ MENÚ INFERIOR (BOTTOM SHEET) ============ -->
        <Grid x:Name="Overlay" IsVisible="False">
            <!-- Fondo oscuro: al tocarlo se cierra el menú -->
            <BoxView Color="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Menú: agregar -->
            <Border x:Name="AddSheet" Style="{StaticResource Sheet}">
                <VerticalStackLayout Spacing="8">
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" HorizontalOptions="Center"
                             Color="{StaticResource Gray300}" Margin="0,0,0,8" />
                    <Label Text="Agregar" FontSize="20" FontAttributes="Bold" Margin="0,0,0,4"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Grid ColumnDefinitions="48,*" ColumnSpacing="16" Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTomarFotoTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource MenuIcon}" BackgroundColor="{StaticResource Info}">
                            <Label Text="📷" Style="{StaticResource MenuEmoji}" />
                        </Border>
                        <Label Grid.Column="1" Text="Tomar foto" Style="{StaticResource MenuText}" />
                    </Grid>

                    <Grid ColumnDefinitions="48,*" ColumnSpacing="16" Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnImportarGaleriaTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource MenuIcon}" BackgroundColor="{StaticResource Success}">
                            <Label Text="🖼️" Style="{StaticResource MenuEmoji}" />
                        </Border>
                        <Label Grid.Column="1" Text="Importar de la galería" Style="{StaticResource MenuText}" />
                    </Grid>

                    <Grid ColumnDefinitions="48,*" ColumnSpacing="16" Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNuevoLoteTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource MenuIcon}" BackgroundColor="{StaticResource LogoLavender}">
                            <Label Text="📁" Style="{StaticResource MenuEmoji}" />
                        </Border>
                        <Label Grid.Column="1" Text="Nuevo lote" Style="{StaticResource MenuText}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Menú contextual: opciones del documento -->
            <Border x:Name="ItemSheet" Style="{StaticResource Sheet}">
                <VerticalStackLayout Spacing="8">
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" HorizontalOptions="Center"
                             Color="{StaticResource Gray300}" Margin="0,0,0,8" />
                    <Label x:Name="ItemTitle" FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation" Margin="0,0,0,4"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Grid ColumnDefinitions="48,*" ColumnSpacing="16" Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVerEditarTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource MenuIcon}" BackgroundColor="{StaticResource Info}">
                            <Label Text="✏️" Style="{StaticResource MenuEmoji}" />
                        </Border>
                        <Label Grid.Column="1" Text="Ver y editar texto" Style="{StaticResource MenuText}" />
                    </Grid>

                    <Grid ColumnDefinitions="48,*" ColumnSpacing="16" Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExportarExcelTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource MenuIcon}" BackgroundColor="{StaticResource Success}">
                            <Label Text="📊" Style="{StaticResource MenuEmoji}" />
                        </Border>
                        <Label Grid.Column="1" Text="Exportar a Excel" Style="{StaticResource MenuText}" />
                    </Grid>

                    <Grid ColumnDefinitions="48,*" ColumnSpacing="16" Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRenombrarTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource MenuIcon}" BackgroundColor="{StaticResource LogoLavender}">
                            <Label Text="🏷️" Style="{StaticResource MenuEmoji}" />
                        </Border>
                        <Label Grid.Column="1" Text="Renombrar" Style="{StaticResource MenuText}" />
                    </Grid>

                    <Grid ColumnDefinitions="48,*" ColumnSpacing="16" Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEliminarTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource MenuIcon}" BackgroundColor="{StaticResource Danger}">
                            <Label Text="🗑️" Style="{StaticResource MenuEmoji}" />
                        </Border>
                        <Label Grid.Column="1" Text="Eliminar" Style="{StaticResource MenuText}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
